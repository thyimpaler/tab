{
  "name": "@tabpaysi/mcp",
  "version": "0.1.0",
  "description": "MCP server that lets Claude, Cursor or any MCP agent pay x402 APIs on Solana from a capped TAB allowance. The agent never holds a wallet key.",
  "type": "module",
  "bin": {
    "tab-mcp": "./dist/index.js"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "tsc -p tsconfig.json"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "x402",
    "solana",
    "usdc",
    "ai-agent",
    "agent-payments",
    "claude"
  ],
  "homepage": "https://tabpay.si/docs#mcp",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tabpaysi/sdk": "^0.1.0",
    "zod": "^4.6.7"
  }
}
