{
  "name": "@tabpay/sdk",
  "version": "0.1.0",
  "description": "Give an AI agent a capped, expiring, revocable USDC allowance on Solana. Pays x402 V2 automatically.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "tsc -p tsconfig.json"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "x402",
    "solana",
    "usdc",
    "ai-agent",
    "agent-payments",
    "spending-limit",
    "allowance"
  ],
  "homepage": "https://tappay.si/docs#sdk",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
