DATABASE_URL=postgres://tab:tab@localhost:5432/tab
SOLANA_RPC_URL=https://api.devnet.solana.com   # use a production RPC provider for mainnet
SOLANA_NETWORK=devnet
USDC_MINT=                                      # devnet or mainnet USDC mint
DELEGATE_PRIVATE_KEY=                           # NEVER commit; move to KMS for production
CREDENTIAL_HASH_SECRET=                         # server-side pepper for credential hashing
PORT=8787

# Paid-API market (optional). Pays MARKET_PAY_TO (default DEMO_MERCHANT). Off on mainnet unless MARKET_ON_MAINNET=1.
MARKET_PAY_TO=
# Mainnet RPC the market reads data from (default: public mainnet RPC). Never put a keyed URL anywhere public.
MARKET_DATA_RPC_URL=
MARKET_ON_MAINNET=
