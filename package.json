{
  "name": "tab",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "tsx watch src/server/dev.ts",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/server/migrate.ts",
    "dev:db": "tsx src/server/devdb.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@x402/core": "^2.28.0",
    "@x402/hono": "^2.28.0",
    "@x402/svm": "^2.28.0",
    "bs58": "^6.0.0",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "tweetnacl": "^1.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@solana/wallet-standard-features": "^1.5.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@wallet-standard/app": "^1.1.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "rpc-websockets": {
      "uuid": "9.0.1"
    }
  }
}
